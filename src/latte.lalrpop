use crate::parser::tokens::{Token, LexicalError};
use crate::parser::utils;

grammar;

extern {
    type Location = usize;
    type Error = LexicalError;
      
    // Define token types from the custom lexer.
    enum Token {
        "ident" => Token::Identifier(<String>),
        "integer_lit" => Token::LiteralInteger(<i32>),
        "string_lit" => Token::LiteralString(<String>),
        
        // Keywords
        "class" => Token::KWClass,
        "extends" => Token::KWExtends,
        "int" => Token::KWInt,
        "string" => Token::KWString,
        "boolean" => Token::KWBool,
        "void" => Token::KWVoid,
        "if" => Token::KWIf,
        "else" => Token::KWElse,
        "while" => Token::KWWhile,
        "for" => Token::KWFor,
        "return" => Token::KWReturn,
        "true" => Token::KWTrue,
        "false" => Token::KWFalse,
        "new" => Token::KWNew,
        "null" => Token::KWNull,

        // Operators
        "+" => Token::OPAdd,
        "-" => Token::OPSub,
        "*" => Token::OPMul,
        "/" => Token::OPDiv,
        "%" => Token::OPMod,
        "<" => Token::OPLt,
        "<=" => Token::OPLe,
        ">" => Token::OPGt,
        ">=" => Token::OPGe,
        "==" => Token::OPEq,
        "!=" => Token::OPNeq,
        "&&" => Token::OPAnd,
        "||" => Token::OPOr,
        "!" => Token::OPNot,
        "=" => Token::OPAssign,
        "++" => Token::OPIncr,
        "--" => Token::OPDecr,

        // Misc
        "(" => Token::LParen,
        ")" => Token::RParen,
        "{" => Token::LBrace,
        "}" => Token::RBrace,
        "[" => Token::LBracket,
        "]" => Token::RBracket,
        ";" => Token::Semicolon,
        ":" => Token::Colon,
        "," => Token::Comma,
        "." => Token::Dot,
    }

}

////////////
/// MISC ///
////////////
PositionedIdent: ast::Ident = {
    <start: @L> <i: "ident"> <end: @R> => ast::Ident(i, SourcePosition(start, end)),
};

// Added to avoid shift-reduce conflicts.
PositionedTypeIdent: ast::Ident = {
    <ident: PositionedIdent> => ident,
}

Comma<T>: Vec<T> = {
    <v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
}

#[inline]
CommaNonEmpty<T>: Vec<T> = {
    <mut v:(<T> ",")+> <e:T?> => match e {
        None => v,
        Some(e) => { v.push(e); v }
    }
};
///////////////
/// PROGRAM ///
///////////////
pub Program: ast::Program = {
    <start: @L> <defs: TopDef*> <end: @R> => ast::Program(
        defs,
        position: SourcePosition(start, end),
    )
};

/////////////////////////////
/// TOP-LEVEL DEFINITIONS ///
/////////////////////////////
TopDef: ast::TopDef = {
    <start: @L> <f: FuncDef> <end: @R> => ast::TopDef {
        kind: ast::TopDefKind::Func(f),
        position: SourcePosition(start, end),
    },
    <start: @L> <c: ClassDef> <end: @R> => ast::TopDef {
        kind: ast::TopDefKind::Class(c),
        position: SourcePosition(start, end),
    },
};

/// Functions ///
FuncDef: ast::FuncDef = {
    <start: @L> <ret_type: Type> <name: PositionedIdent> "(" <args: Comma<Arg>> ")" <body: Block> <end: @R> => ast::FuncDef {
        name,
        ret_type,
        args,
        body,
        position: SourcePosition(start, end),
    },
};

Arg: ast::Arg = {
    <start: @L> <arg_type: Type> <name: PositionedIdent> <end: @R> => ast::Arg {
        arg_type,
        name,
        position: SourcePosition(start, end),
    }
};

/// Classes ///
ClassDef: ast::ClassDef = {
    <start: @L> "class" <name: PositionedIdent> <extends: ("extends" PositionedIdent)?> "{" <entries: ClassEntry*> "}" <end: @R> => ast::ClassDef {
        name,
        extends,
        entries,
        position: SourcePosition(start, end),
    },
}

ClassEntry: ast::ClassEntry = {
    <start: @L> <typ: Type> <name: PositionedIdent> ";" <end: @R> => ast::ClassEntry {
        kind: ast::ClassEntryKind::Field(typ, name),
        position: SourcePosition(start, end),
    },
    <start: @L> <method: FuncDef> <end: @R> => ast::ClassEntry {
        kind: ast::ClassEntryKind::Method(method),
        position: SourcePosition(start, end),
    },
}

///////////////////
/// STATEMENTS ///
//////////////////
Block: ast::Block = {
    <start: @L> "{" <stmts: Stmt*> "}" <end: @R> => ast::Block {
        stmts,
        position: SourcePosition(start, end),
    },
}

// https://en.wikipedia.org/wiki/Dangling_else
// https://www.cs.cornell.edu/andru/javaspec/19.doc.html
Stmt: ast::Stmt = {
    OpenStmt,
    ClosedStmt,
}

ClosedStmt: ast::Stmt = {
    SimpleStmt,
    <start: @L> "if" "(" <cond: Expr> ")" <if_true: ClosedStmt> "else" <if_false: ClosedStmt> <end: @R> => ast::Stmt {
        kind: ast::StmtKind::If{
            cond,
            if_true: Box::new(if_true),
            if_false: Some(Box::new(if_false)),
        },
        position: SourcePosition(start, end),
    },
    <start: @L> "while" "(" <cond: Expr> ")" <body: ClosedStmt> <end: @R> => ast::Stmt {
        kind: ast::StmtKind::While{ cond, body: Box::new(body) },
        position: SourcePosition(start, end),
    },
    <start: @L> "for" "(" <element_type: Type> <item_name: PositionedIdent> ":" <collection: Expr> ")" <body: ClosedStmt> <end: @R> => ast::Stmt {
        kind: ast::StmtKind::ForEach{
            element_type,
            item_name,
            collection,
            body: Box::new(body),
        },
        position: SourcePosition(start, end),
    },
};

OpenStmt: ast::Stmt = {
    <start: @L> "if" "(" <cond: Expr> ")" <if_true: Stmt> <end: @R> => ast::Stmt {
        kind: ast::StmtKind::If {
            cond,
            if_true: Box::new(if_true),
            if_false: None,
        },
        position: SourcePosition(start, end),
    },
    <start: @L> "if" "(" <cond: Expr> ")" <if_true: ClosedStmt> "else" <if_false: OpenStmt> <end: @R> => ast::Stmt {
        kind: ast::StmtKind::If {
            cond,
            if_true: Box::new(if_true),
            if_false: Some(Box::new(if_false)),
        },
        position: SourcePosition(start, end),
    },
    <start: @L> "while" "(" <cond: Expr> ")" <body: OpenStmt> <end: @R> => ast::Stmt {
        kind: ast::StmtKind::While { 
            cond, 
            body: Box::new(body) 
        },
        position: SourcePosition(start, end),
    },
    <start: @L> "for" "(" <element_type: Type> <item_name: PositionedIdent> ":" <collection: Expr> ")" <body: OpenStmt> <end: @R> => ast::Stmt {
        kind: ast::StmtKind::ForEach {
            element_type,
            item_name,
            collection,
            body: Box::new(body),
        },
        position: SourcePosition(start, end),
    },
};

SimpleStmt: ast::Stmt = {
    <start: @L> ";" <end: @R> => ast::Stmt {
        kind: ast::StmtKind::Empty,
        position: SourcePosition(start, end),
    },
    <start: @L> <block: Block> <end: @R> => ast::Stmt {
        kind: ast::StmtKind::Block(block),
        position: SourcePosition(start, end),
    },
    <start: @L> <t: Type> <items: CommaNonEmpty<Item>> ";" <end: @R> => ast::Stmt {
        kind: ast::StmtKind::Decl(t, items),
        position: SourcePosition(start, end),
    },
    // TODO: LValue.
    <start: @L> <target: Expr> "=" <value: Expr> ";" <end: @R> => ast::Stmt {
        kind: ast::StmtKind::Assign {
            target, 
            value,
        },
        position: SourcePosition(start, end),
    },
    <start: @L> "return" <expr: Expr?> ";" <end: @R> => ast::Stmt {
        kind: ast::StmtKind::Return(expr),
        position: SourcePosition(start, end),
    },
    <start: @L> <expr: Expr> "++" ";" <end: @R> => ast::Stmt {
        kind: ast::StmtKind::Incr(expr),
        position: SourcePosition(start, end),
    },
    <start: @L> <expr: Expr> "--" ";" <end: @R> => ast::Stmt {
        kind: ast::StmtKind::Decr(expr),
        position: SourcePosition(start, end),
    },
    <start: @L> <expr: Expr> ";" <end: @R> => ast::Stmt {
        kind: ast::StmtKind::Expr(expr),
        position: SourcePosition(start, end),
    },
    <start: @L> <f: FuncDef> <end: @R> => ast::Stmt {
        kind: ast::StmtKind::FuncDef(f),
        position: SourcePosition(start, end),
    },
};

Item: ast::Item = {
    <start: @L> <name: PositionedIdent> <end: @R> => ast::Item {
        kind: ast::ItemKind::NoInit(name),
        position: SourcePosition(start, end),
    },
    <start: @L> <name: PositionedIdent> "=" <expr: Expr> <end: @R> => ast::Item {
        kind: ast::ItemKind::Init(name, expr),
        position: SourcePosition(start, end),

    },
};

/////////////
/// TYPES ///
/////////////
#[inline]
Type: ast::Type = {
    BaseType,
    <start: @L> <base: BaseType> "[" "]" <end: @R> => {
        ast::Type {
            kind: ast::TypeKind::Array(Box::new(base)),
            position: SourcePosition(start, end),
        }
    },
};

// Non-array types.
BaseType: ast::Type = {
    <start: @L> "int" <end: @R> => ast::Type { kind: ast::TypeKind::Int, position: SourcePosition(start, end) },
    <start: @L> "string" <end: @R> => ast::Type { kind: ast::TypeKind::String, position: SourcePosition(start, end) },
    <start: @L> "boolean" <end: @R> => ast::Type { kind: ast::TypeKind::Bool, position: SourcePosition(start, end) },
    <start: @L> "void" <end: @R> => ast::Type { kind: ast::TypeKind::Void, position: SourcePosition(start, end) },
    <start: @L> <id: PositionedTypeIdent> <end: @R> => ast::Type { kind: ast::TypeKind::Class(id), position: SourcePosition(start, end) },
};
///////////////////
/// EXPRESSIONS ///
///////////////////
LValue: Box<ast::Expr> = {
    <id: PositionedIdent> => Box::new(ast::Expr {
        kind: ast::ExprKind::Var(id.clone()),
        position: id.1,
    }),
    <object: LValue> "." <field_name: PositionedIdent> => Box::new(ast::Expr {
        kind: ast::ExprKind::Field { object, field_name: field_name.clone() },
        position: SourcePosition(object.position.0, field_name.1.1)
    }),
    <array: LValue> "[" <index: Expr> "]" <end: @R> => Box::new(ast::Expr {
        kind: ast::ExprKind::ArrayAccess { array, index },
        position: SourcePosition(array.position.0, end)
    }),
};


Expr: Box<ast::Expr> = {
    ExprOr,
};

ExprOr: Box<ast::Expr> = {
    <l: ExprOr> "||" <r: ExprAnd> => make_binary(ast::BinaryOp::Or, l, r),
    ExprAnd,
};

ExprAnd: Box<ast::Expr> = {
    <l: ExprAnd> "&&" <r: ExprEq> => make_binary(ast::BinaryOp::And, l, r),
    ExprEq,
};

ExprEq: Box<ast::Expr> = {
    <l: ExprEq> "==" <r: ExprRel> => make_binary(ast::BinaryOp::Eq, l, r),
    <l: ExprEq> "!=" <r: ExprRel> => make_binary(ast::BinaryOp::Neq, l, r),
    ExprRel,
};

ExprRel: Box<ast::Expr> = {
    <l: ExprRel> "<" <r: ExprAdd> => make_binary(ast::BinaryOp::Lt, l, r),
    <l: ExprRel> "<=" <r: ExprAdd> => make_binary(ast::BinaryOp::Le, l, r),
    <l: ExprRel> ">" <r: ExprAdd> => make_binary(ast::BinaryOp::Gt, l, r),
    <l: ExprRel> ">=" <r: ExprAdd> => make_binary(ast::BinaryOp::Ge, l, r),
    ExprAdd,
};

ExprAdd: Box<ast::Expr> = {
    <l: ExprAdd> "+" <r: ExprMul> => make_binary(ast::BinaryOp::Add, l, r),
    <l: ExprAdd> "-" <r: ExprMul> => make_binary(ast::BinaryOp::Sub, l, r),
    ExprMul,
};

ExprMul: Box<ast::Expr> = {
    <l: ExprMul> "*" <r: ExprUnary> => make_binary(ast::BinaryOp::Mul, l, r),
    <l: ExprMul> "/" <r: ExprUnary> => make_binary(ast::BinaryOp::Div, l, r),
    <l: ExprMul> "%" <r: ExprUnary> => make_binary(ast::BinaryOp::Mod, l, r),
    ExprUnary,
};

ExprUnary: Box<ast::Expr> = {
    <start: @L> "-" <e: ExprUnary> <end: @R> => make_unary(start, ast::UnaryOp::Neg, e, end),
    <start: @L> "!" <e: ExprUnary> <end: @R> => make_unary(start, ast::UnaryOp::Not, e, end),
    ExprPostfix,
};

ExprPostfix: Box<ast::Expr> = {
    <callee: ExprPostfix> "(" <args: Comma<Expr>> ")" <end: @R> => Box::new(ast::Expr {
        kind: ast::ExprKind::App { callee, args },
        position: SourcePosition(callee.position.0, end),
    }),
    <object: ExprPostfix> "." <field_name: PositionedIdent> => Box::new(ast::Expr {
        kind: ast::ExprKind::Field { object, field_name: field_name.clone() },
        position: SourcePosition(object.position.0, field_name.1.1)
    }),
    <array: ExprPostfix> "[" <index: Expr> "]" <end: @R> => Box::new(ast::Expr {
        kind: ast::ExprKind::ArrayAccess { array, index },
        position: SourcePosition(array.position.0, end)
    }),
    <object: ExprPostfix> "." <method_name: PositionedIdent> "(" <args: Comma<Expr>> ")" <end: @R> => Box::new(ast::Expr {
        kind: ast::ExprKind::Method { object, method_name, args },
        position: SourcePosition(object.position.0, end)
    }),
    ExprPrimary,
};

ExprPrimary: Box<ast::Expr> = {
    <start: @L> <i: "integer_lit"> <end: @R> => Box::new(ast::Expr {
        kind: ast::ExprKind::LiteralInt(i),
        position: SourcePosition(start, end),
    }),
    <start: @L> "true" <end: @R> => Box::new(ast::Expr {
        kind: ast::ExprKind::LiteralTrue,
        position: SourcePosition(start, end),
    }),
    <start: @L> "false" <end: @R> => Box::new(ast::Expr {
        kind: ast::ExprKind::LiteralFalse,
        position: SourcePosition(start, end),
    }),
    <start: @L> <s: "string_lit"> <end: @R> => Box::new(ast::Expr {
        kind: ast::ExprKind::LiteralString(s),
        position: SourcePosition(start, end),
    }),
    <start: @L> "null" <end: @R> => Box::new(ast::Expr {
        kind: ast::ExprKind::LiteralNull,
        position: SourcePosition(start, end)
    }),
    <id: PositionedIdent> => Box::new(ast::Expr {
        kind: ast::ExprKind::Var(id.clone()),
        position: id.1,
    }),
    <start: @L> "new" <t: Type> <end: @R> => {
        if let ast::TypeKind::Class(id) = t.kind {
            Box::new(ast::Expr {
                kind: ast::ExprKind::NewObject(id),
                position: SourcePosition(start, end)
            })
        } else {
            Box::new(ast::Expr {
                kind: ast::ExprKind::NewObject(ast::Ident("error".to_string(), t.position)),
                position: SourcePosition(start, end)
            })
        }
    },
    <start: @L> "new" <t: Type> "[" <size: Expr> "]" <end: @R> => Box::new(ast::Expr {
        kind: ast::ExprKind::NewArray { element_type: t, size },
        position: SourcePosition(start, end)
    }),
    <start: @L> "(" <e: Expr> ")" <end: @R> => Box::new(ast::Expr {
        kind: ast::ExprKind::Paren(e),
        position: SourcePosition(start, end)
    }),
};