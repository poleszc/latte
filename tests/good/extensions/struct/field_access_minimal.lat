class Kajak {
	Kajak poprzedni, nastepny;
	int wartosc;
}

class list {
    int elem;
    int[] array;
    Kajak kajak;
}

int main() {
    list a = new list;
    a.elem++;
    a.array = new int[4];
    a.array[0]++;
    a.kajak = new Kajak;
    a.kajak.wartosc = 23;
    printInt(a.kajak.wartosc);
    a.kajak.wartosc = a.array[0];
    printInt(a.kajak.wartosc);

    printInt(a.array[0]);


    return a.array[2];
}
