class A {
    int a;
    int foo() {
        return 1;
    }

}

class B extends A {
    int b;
    int goo() {
        return 2;
    }
}

class C extends B {
    int c;
    int boo() {
        return 3;
    }
}

int main() {
    A a = new A;
    B b = new B;
    C c = new C;
    
    printInt(a.foo());
    printInt(b.foo());
    printInt(b.goo());
    printInt(c.foo());
    printInt(c.goo());
    printInt(c.boo());
    
    return 0;
}
