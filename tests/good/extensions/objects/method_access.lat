class A {
    int a;

    int foo() {
        int x = this.goo();
        return x + 100;
    }

    int goo() {
        return this.a;
    }
}

class B extends A {
    int b;

    int goo() {
        return a + this.b;
    }

    int bar() {
        return this.foo() + 1000;
    }
}

int main() {
    printInt(111111);

    A objA = new A;
    objA.a = 10;
    printInt(objA.foo()); // 110

    printInt(222222);

    B objB = new B;
    objB.a = 20;
    objB.b = 30;
    
    printInt(objB.foo()); // (20 + 30) + 100 = 150
    printInt(objB.bar()); //objB.foo() + 1000 = 150 + 1000 = 1150

    printInt(333333); // Test polimorfizmu

    A poly = objB;
    printInt(poly.foo()); // 150

    return 0;
}
