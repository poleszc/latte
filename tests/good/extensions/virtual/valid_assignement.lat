class GrandParent {
    int x;
}

class Parent extends GrandParent {
    int y;
}

class Child extends Parent {
    int z;
}

int main() {
    // Simple.
    int i = 10;
    int i2 = i;
    boolean b = true;
    boolean b2 = false;
    b = b2;
    string s = "hello";
